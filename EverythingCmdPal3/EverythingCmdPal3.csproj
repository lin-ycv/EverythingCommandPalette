<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EverythingCmdPal3</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- The Store reserves the fourth version component. Advance Major/Minor/Build instead. -->
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <GenerateAppxPackageOnBuild Condition="'$(Configuration)'=='Release'">true</GenerateAppxPackageOnBuild>
	  <GenerateSatelliteAssembliesForCore Condition="'$(Configuration)'=='Release'">true</GenerateSatelliteAssembliesForCore>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\EverythingPT.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep all scale/theme variants, including StoreLogo, in the package and PRI. -->
    <Content Include="Assets\*.png" Exclude="Assets\LockScreenLogo*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" PrivateAssets="all" />
    <PackageReference Include="Shmuelie.WinRTServer" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="ToolGood.Words.Pinyin" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.zh-HK.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.zh-HK.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.zh-TW.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.zh-TW.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.zh-HK.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.zh-HK.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-TW.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.zh-TW.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Everything3_x64.dll">
      <CopyToOutputDirectory Condition="'$(Platform)' == 'x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(Platform)' == 'x64'">PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Everything3_ARM64.dll">
      <CopyToOutputDirectory Condition="'$(Platform)' == 'ARM64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(Platform)' == 'ARM64'">PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="Assets\EverythingPT.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\EverythingPT_theme-light.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\EverythingPT_theme-dark.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\.gitkeep" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <DefineConstants>$(DefineConstants);ARM64</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Helper\Helper.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="IncludeHelper" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_HelperFile Include="..\Helper\bin\$(Platform)\$(Configuration)\net10.0-windows\**\*.*" />
      <Content Include="@(_HelperFile)" Link="Win32\%(_HelperFile.RecursiveDir)%(_HelperFile.Filename)%(_HelperFile.Extension)" TargetPath="Win32\%(_HelperFile.RecursiveDir)%(_HelperFile.Filename)%(_HelperFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromResourceIndex="true" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateSdkArchitecture" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'" Text="Build ECP3 with Platform=x64 or Platform=ARM64 to select the matching SDK3 library." />
    <Error Condition="('$(Platform)' == 'x64' and '$(RuntimeIdentifier)' != 'win-x64') or ('$(Platform)' == 'ARM64' and '$(RuntimeIdentifier)' != 'win-arm64')" Text="Platform and RuntimeIdentifier must select the same architecture." />
  </Target>
  <Target Name="ValidateStoreVersion" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="_StoreManifestVersion" />
    </XmlPeek>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_StoreManifestVersion)', '^[1-9][0-9]*\.[0-9]+\.[0-9]+\.0$'))" Text="Store packages require a nonzero major version and a zero fourth component. Update Package.appxmanifest from '$(_StoreManifestVersion)' to Major.Minor.Build.0; increment Build for updates." />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Suppress DynamicallyAccessedMemberTypes.PublicParameterlessConstructor in fallback code path of Windows SDK projection -->
    <WarningsNotAsErrors>IL2081</WarningsNotAsErrors>

    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Release'">false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
</Project>
